# Environment Configuration for Parking SaaS ALPR Platform

# Environment
ENVIRONMENT=development
DEBUG=True

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Parking SaaS ALPR"
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=parkingsaas_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/parkingsaas_db

# Computer Vision Service
CV_DEVICE=auto
CV_CONFIG_PATH=computer-vision/config/alpr_config.yaml

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://localhost:3000","http://127.0.0.1:4200"]
