# Backend & ALPR Monorepo Container Image
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/backend:/app/computer-vision/src"

# Install system dependencies for OpenCV, PostgreSQL, PyTorch and networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies from both backend and CV
COPY backend/requirements.txt /app/backend/requirements.txt
COPY computer-vision/requirements.txt /app/computer-vision/requirements.txt

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/backend/requirements.txt && \
    pip install --no-cache-dir -r /app/computer-vision/requirements.txt

# Copy source code
COPY backend/ /app/backend/
COPY computer-vision/ /app/computer-vision/

EXPOSE 8000

WORKDIR /app/backend

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
